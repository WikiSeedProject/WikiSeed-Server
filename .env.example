# Copy to .env and fill in.

# --- PostgreSQL ----------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=wikiseed
POSTGRES_USER=wikiseed
POSTGRES_PASSWORD=changeme

# --- Storage -------------------------------------------------------------
# Mount path on the host for the HDD. Mounted into containers at /data.
WIKISEED_DATA_DIR=/mnt/wikiseed-data
WIKISEED_MANIFEST_DIR=/etc/wikiseed/manifest
STORAGE_BUDGET_BYTES=20000000000000

# --- WikiSeed identity ---------------------------------------------------
WIKISEED_VERSION=1.0
WIKISEED_USER_AGENT=WikiSeed.app/1.0 (contact: ops@wikiseed.app)

# --- Health thresholds ---------------------------------------------------
HEALTH_MIN_SEEDERS=4
HEALTH_BELOW_THRESHOLD_HOURS=24

# --- Cloudflare R2 -------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=wikiseed

# --- Internet Archive ----------------------------------------------------
IA_ACCESS_KEY=
IA_SECRET_KEY=

# --- qBittorrent ---------------------------------------------------------
QBITTORRENT_HOST=qbittorrent
QBITTORRENT_PORT=8080
QBITTORRENT_USER=admin
QBITTORRENT_PASSWORD=adminadmin

# --- GitHub fallback for manifest ----------------------------------------
GITHUB_TOKEN=
GITHUB_REPO=WikiSeedProject/WikiSeed-Server
GITHUB_MANIFEST_BRANCH=manifest

# --- qBittorrent container user (linuxserver image) ---------------------
PUID=1000
PGID=1000
TZ=UTC

# --- Logging -------------------------------------------------------------
LOG_LEVEL=INFO
